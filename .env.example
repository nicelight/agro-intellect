APP_NAME=agro-intellect
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost/agro_intellect
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true
LOCAL_DATA_ROOT=data
LOCAL_ARTIFACT_ROOT=data/artifacts
LOCAL_TIMELINE_ROOT=data/timeline
LOCAL_TEMP_ROOT=data/tmp
LOCAL_SMOKE_ROOT=data/smoke
SYNC_STATUS=local_only
AGENT_MODEL_BINDINGS_JSON={}
AGENT_EXTERNAL_EGRESS_ENABLED=false
# Credentialed test-only smoke inputs (no defaults; never commit credentials):
# AGENT_REAL_SMOKE_PROFILE=deepseek|gemini
# AGENT_REAL_SMOKE_MODEL_ID=<explicit-provider-model-id>
# DEEPSEEK_API_KEY or GOOGLE_API_KEY is supplied only by the local environment.
