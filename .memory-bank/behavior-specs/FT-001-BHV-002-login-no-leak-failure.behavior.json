{
  "id": "FT-001-BHV-002",
  "feature_id": "FT-001",
  "title": "Invalid login fails without account enumeration or secret leakage",
  "given": {
    "submitted_login_name": "unknown-or-wrong",
    "submitted_password": "wrong-password"
  },
  "when": {
    "request": "POST /api/session/login"
  },
  "then": {
    "status": 401,
    "error_code": "AUTH_CREDENTIAL_INVALID",
    "message": "generic no-leak authentication failure",
    "must_not_reveal": [
      "whether login exists",
      "submitted password",
      "password hash",
      "session token",
      "token hash"
    ]
  }
}
